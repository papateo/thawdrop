node_modules/
dist/

# Local-only secrets (e.g. TURN credentials) — never commit these.
.env
.env.local
.env.*.local

# Updater signing key — signs auto-update releases; never commit.
apps/desktop/src-tauri/.updater-keys/

# Published release artifacts (generated by publish-release.sh, deployed
# straight to Cloudflare — no need to version binary builds in git).
apps/web/public/updates/
# Same for the first-install DMG that publish-release.sh copies in.
apps/web/public/download/

# Rust build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

*.log
.DS_Store

# IDE settings
.idea/
